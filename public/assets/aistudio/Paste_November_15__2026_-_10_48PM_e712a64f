                                    d === 0 || d === 1 ? "bg-rose-500/20 text-rose-400 border border-rose-500/30" :
                                    d === 2 || d === 7 ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" :
                                    "bg-white/5 text-slate-300"
                                  )}
