                <span className="text-[10px] font-black text-[#555] uppercase tracking-widest leading-none mb-1">Total Profit</span>
                <span className={cn(
                  "text-5xl font-black tracking-tighter",
                  tpSlResult.profit >= 0 ? "text-emerald-400" : "text-rose-400"
