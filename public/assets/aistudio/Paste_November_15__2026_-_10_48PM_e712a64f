              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className={cn(
                "w-full max-w-sm p-8 rounded-[2.5rem] border text-center space-y-6 shadow-2xl relative overflow-hidden",
