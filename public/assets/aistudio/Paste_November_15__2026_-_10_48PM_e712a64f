                                "p-0.5 rounded",
                                pct8and9 <= 20.0 ? "text-emerald-400 bg-emerald-500/10 font-bold" :
                                "text-slate-500"
                              )}>
                                %8+9: {pct8and9.toFixed(1)}%
                              </div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
