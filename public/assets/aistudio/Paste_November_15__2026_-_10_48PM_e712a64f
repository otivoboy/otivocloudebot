              { id: 'even_odd', label: 'Even / Odd', icon: '⚖️', desc: 'Parity Momentum & Streaks' },
              { id: 'rise_fall', label: 'Rise / Fall', icon: '📈', desc: 'Multi-Timeframe Signals' },
