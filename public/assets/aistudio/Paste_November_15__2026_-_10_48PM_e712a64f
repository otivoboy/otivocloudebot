              <input 
                type="number"
                min="10"
                max="5000"
                value={tempWindow}
                onChange={(e) => setTempWindow(e.target.value)}
                onBlur={() => {
                  let num = parseInt(tempWindow, 10);
                  if (isNaN(num) || num < 10) num = 100;
                  if (num > 5000) num = 5000;
                  setTempWindow(num.toString());
                  setAnalysisWindow(num);
                }}
                onKeyDown={(e) => {
                  if (e.key === 'Enter') {
