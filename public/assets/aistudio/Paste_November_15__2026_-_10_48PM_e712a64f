                  botEngine.loadTransactions();

                  if (hackerAutoRestartWinRef.current) {
                    addHackerLog(`[AUTO-RESTART ON VIRTUAL WIN] Opposite virtual trade was a WIN! Automatically restarting bot to retry for a virtual LOSS...`);
